# Copy to .env and fill in real values. .env is gitignored.
FTP_HOST=ftp.example.com
CPANEL_USER=youruser
PROD_REMOTE_PATH=public_html/yourdomain.example.com
TEST_REMOTE_PATH=public_html/yourdomain-test.example.com
TEST_HTPASSWD=someuser:{SHA}somehash=

# Per-environment MySQL DB for the events table (scripts/deploy writes these
# into db_config.php on upload; leave an environment's DB_* vars unset to skip
# writing db_config.php for it, e.g. before prod has its own database yet).
TEST_DB_HOST=localhost
TEST_DB_NAME=yourcpaneluser_bmwtest
TEST_DB_USER=yourcpaneluser_bmwtest
TEST_DB_PASS=
PROD_DB_HOST=localhost
PROD_DB_NAME=yourcpaneluser_bmwprod
PROD_DB_USER=yourcpaneluser_bmwprod
PROD_DB_PASS=

# htpasswd line (any format Apache accepts, e.g. via `htpasswd -nbB user pass`)
# gating /admin on whichever environment is being deployed.
ADMIN_HTPASSWD=admin:{SHA}somehash=
